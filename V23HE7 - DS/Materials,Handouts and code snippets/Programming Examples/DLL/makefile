a.out : Menu.o AddFirst.o Display.o DelFirst.o DelLast.o Reverse.o
	cc Menu.o AddFirst.o Display.o DelFirst.o DelLast.o Reverse.o
Menu.o : Menu.c
	cc -c Menu.c
AddFirst.o : AddFirst.c
	cc -c AddFirst.c
Display.o : Display.c
	cc -c Display.c
DelFirst.o : DelFirst.c
	cc -c DelFirst.c
DelLast.o : DelLast.c
	cc -c DelLast.c
Reverse.o :Reverse.c
	cc -c Reverse.c
